<?xml version="1.0" encoding="utf-8"?>
<!--
    HTTPS is required for every real endpoint. Cleartext is permitted only for
    loopback, so a local model server (Ollama, llama.cpp, LM Studio) running on
    this same device over http://127.0.0.1 works, while nothing can silently
    ship your data to a plaintext host on the internet.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
