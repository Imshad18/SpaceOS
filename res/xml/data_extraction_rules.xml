<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves the device in a backup or a device-to-device transfer.
    The API key and the conversation memory both live in files/, and neither
    belongs in a cloud backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
